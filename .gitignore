# ---- large data (regenerate via the pipeline; do not commit ~7GB of dumps) ----
data/raw/
data/external/
data/processed/*.csv
data/processed/*.pkl
data/processed/benchmark*/
data/processed/consensus/
data/processed/provenance/
data/processed/*.json
data/processed/*.png
*.embeddings
node2vec_embeddings.csv
*_embeddings.csv

# keep small, useful processed artifacts in version control explicitly:
!data/processed/relationship_vocab.csv
!data/processed/dataset_relation_map.json
!data/registry/

# ---- secrets / local env ----
.env
*.secret
secrets.*

# ---- python ----
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ---- editor / OS ----
# Ignore .vscode/ EXCEPT the two files we share with collaborators so everyone
# gets the same LaTeX build recipe + recommended extensions on clone.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ---- generated output subfolders (large; distributed via the data channel) ----
data/processed/splits/
data/processed/results/
!data/processed/results/**/*.json
data/processed/predictions/
data/processed/validation/
data/processed/benchmark_integrated/

# ---- large interactive HTML explorers / figures (optional; keep if small) ----
*.html
fullgraph_*.png

# ---- root-level generated artifacts (regenerate via pipeline; not for the code repo) ----
*.pkl
/consensus_predictor_model.pkl
/spectral_partition_map.png
/network_growth_over_time.png
/transe_embeddings.csv
# never commit raw dumps under any nesting (belt-and-suspenders with data/raw/ above)
**/data.raw.*

# ---- external third-party graphs (Hetionet etc.); consumed from the data channel, never committed ----
data/external/

# ---- LaTeX build artifacts (compile locally; regenerate every build) ----
# Committing these is the #1 cause of merge conflicts in a shared paper repo.
manuscript/latex/*.aux
manuscript/latex/*.bbl
manuscript/latex/*.blg
manuscript/latex/*.log
manuscript/latex/*.out
manuscript/latex/*.toc
manuscript/latex/*.lof
manuscript/latex/*.lot
manuscript/latex/*.fls
manuscript/latex/*.fdb_latexmk
manuscript/latex/*.synctex.gz
manuscript/latex/*.run.xml
manuscript/latex/*.bcf
manuscript/latex/build/
# The compiled PDF is a binary that conflicts constantly; everyone builds it
# locally. Delete this line if you'd rather commit main.pdf for easy viewing.
manuscript/latex/main.pdf

# ---- manuscript / paper drafts and working notes ----
# The paper itself (drafts, LaTeX source, checklists, cover letter, submission
# figures) is not part of the code+data release and does not belong in this
# repo; it lives wherever the manuscript is actually authored (Overleaf/local).
# Root-level loose .tex/.md notes (e.g. PLOS_manuscript_revised.tex,
# FINDINGS_*.md) are excluded the same way; README.md is explicitly kept, and
# tables/*.md and tables/*.tex (generated benchmark outputs) are untouched
# since they live outside this root-only pattern.
manuscript/
/*.tex
/*.md
!/README.md
# Same rule for the compiled manuscript, cover letter, and LaTeX build output at
# the repo root. figures/*.pdf are generated release artifacts and are NOT root
# level, so they are unaffected.
/*.pdf
/*.log
/*.out
/*.aux
/plan_audit/

# ---- peer-review revision working folder ----
# Revised manuscript, marked-up diff, response letter, S-texts, review planning
# notes and their LaTeX build output. The tables, figures and *_numbers.json in
# here are regenerated by scripts/make_revision_assets.py, overlap_lowdegree.py
# and pool_exclusion.py from the result JSONs, so nothing here is source.
revision/

# ---- Zenodo distribution bundles: too large / redundant for git ----
# splits.zip is ~160 MB, past GitHub's 100 MB hard per-file limit. All three are
# published on Zenodo as the citable archive; the repo carries only a partial
# sample of the unzipped result JSONs for browsing. Download splits.zip and
# results.zip from Zenodo for the full set (see README.md).
data/processed/*.zip
